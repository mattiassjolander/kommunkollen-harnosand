# Kopiera till .env på servern (/opt/kommunkollen/.env). Committa aldrig .env.
POSTGRES_DB=kommunkollen
POSTGRES_USER=kommunkollen
POSTGRES_PASSWORD=byt-mig
HTTP_PORT=80

# Inloggning
SESSION_SECRET=byt-mig-till-en-lang-slumpstrang
SESSION_HTTPS_ONLY=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# epost=roll+roll; epost=roll   (roller: lasare, redaktor, utgivare)
AUTH_ANVANDARE=
# Publik adress om appen nås via en annan adress än den förfrågan kommer in på
PUBLIK_URL=
ANONYM_LASNING=true
TESTENV=false

# Schemalagd insamling, svensk tid. Tomt INSAMLING_DAGAR stänger av schemat.
INSAMLING_DAGAR=1,15
INSAMLING_KLOCKAN=03:00

# Högsta antal anrop per sekund mot varje källa. 0 = ingen gräns.
KOLADA_ANROP_PER_SEKUND=5
SCB_ANROP_PER_SEKUND=2
# Protokoll från harnosand.se (sidan och varje PDF räknas som ett anrop).
PROTOKOLL_ANROP_PER_SEKUND=1
